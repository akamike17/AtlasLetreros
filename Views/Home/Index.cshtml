@{ ViewData["Title"] = "Editor"; }
<div class="app-shell" data-testid="editor">
  <header class="topbar"><a class="brand" href="/"><span class="brand-mark">A</span><span>Atlas<strong>Letrero</strong></span></a><div class="design-name"><span class="eyebrow">DISEÑO ACTUAL <b id="dirtyIndicator" hidden>• SIN GUARDAR</b></span><input id="designName" aria-label="Nombre del diseño" /></div><div class="top-actions"><span id="deviceState" class="device-state offline"><i></i> Consultando…</span><button class="button" id="projectsButton">Proyectos</button><button class="button ghost" id="saveButton">Guardar</button><button class="button primary" id="sendButton">Enviar</button></div></header>
  <main class="workspace">
    <aside class="tool-rail" aria-label="Herramientas"><span class="rail-label">HERRAMIENTAS</span>
      <button class="tool active" data-tool="selection" title="Selección (V)"><span>↖</span>Selección</button><button class="tool" data-tool="pencil" title="Lápiz (P)"><span>✎</span>Lápiz</button><button class="tool" data-tool="eraser" title="Borrador (E)"><span>⌫</span>Borrador</button><button class="tool" data-tool="line" title="Línea (L)"><span>╱</span>Línea</button><button class="tool" data-tool="rectangle" title="Rectángulo (R)"><span>□</span>Rectángulo</button><button class="tool" data-tool="circle" title="Círculo (C)"><span>○</span>Círculo</button><button class="tool" data-tool="fill" title="Relleno (F)"><span>◩</span>Relleno</button><button class="tool" data-tool="text" title="Texto (T)"><span>T</span>Texto</button><button class="tool" data-tool="image" id="imageButton" title="Imagen (I)"><span>▧</span>Imagen</button><input id="imageInput" type="file" accept="image/*" hidden /><div class="rail-divider"></div><button class="tool" id="clearButton"><span>⌧</span>Limpiar</button><button class="tool" id="undoButton"><span>↶</span>Deshacer</button><button class="tool" id="redoButton"><span>↷</span>Rehacer</button>
    </aside>
    <section class="stage-panel"><div class="stage-toolbar"><div><span class="status-dot"></span><strong id="canvasInfo">Canvas</strong><span id="pixelInfo" class="muted"></span></div><div class="zoom-controls"><button id="zoomOut">−</button><span id="zoomValue">100%</span><button id="zoomIn">+</button><button class="grid-toggle active" id="gridToggle"># Cuadrícula</button></div></div><div class="canvas-wrap"><div class="canvas-glow"><canvas id="pixelCanvas" role="application" aria-label="Canvas lógico LED" tabindex="0"></canvas></div></div><div class="playback-bar"><button class="round-button" id="playButton">▶</button><button class="round-button" id="pauseButton">Ⅱ</button><button class="round-button" id="stopPreviewButton">■</button><span id="currentTime" class="timecode">00:00.0</span><input id="timeline" type="range" min="0" max="6000" value="0" /><span id="totalTime" class="timecode">00:06.0</span></div></section>
    <aside class="properties"><div class="panel-heading"><div><span class="eyebrow">PROPIEDADES</span><h2 id="selectionTitle">Documento</h2></div><span class="chip">LED</span></div><label class="field-label">Perfil/resolución</label><select id="resolutionProfile"><option value="16x16">16 × 16</option><option value="32x8">32 × 8</option><option value="32x16" selected>32 × 16</option><option value="64x8">64 × 8</option><option value="64x16">64 × 16</option><option value="128x8">128 × 8</option></select><label class="field-label" for="colorPicker">Color</label><div class="color-field"><input id="colorPicker" type="color" value="#ff6b35" /><input id="colorHex" value="#FF6B35" maxlength="7" /></div><label class="field-label" for="brightness">Brillo <output id="brightnessValue">72%</output></label><input class="range" id="brightness" type="range" min="0" max="100" value="72" /><div class="section-divider"></div><label class="field-label" for="animation">Animación</label><select id="animation"><option value="none">Sin animación</option><option value="blink">Blink</option><option value="fade">Fade</option><option value="scroll">Scroll</option><option value="slide">Slide</option><option value="zoom">Zoom</option><option value="pulse">Pulse</option><option value="wipe">Wipe</option><option value="marquee">Marquee</option><option value="frame">FrameAnimation</option></select><label class="check"><input id="repeat" type="checkbox" checked /> Repetir</label><div class="two-fields"><label>Duración<input id="duration" type="number" value="6" min="0.1" max="3600" step="0.1" /></label><label>Velocidad<input id="speed" type="number" value="1" min="0.1" max="10" step="0.1" /></label></div><div class="section-divider"></div><div class="object-header"><span class="field-label">Capas / objetos</span><div><button id="backButton">↓</button><button id="frontButton">↑</button><button id="deleteObjectButton">×</button></div></div><div id="objectList" class="object-list"></div><div class="section-divider"></div><label class="field-label" for="deviceSelect">Letrero destino</label><select id="deviceSelect"><option value="atlas-simulator">Simulador local</option></select><div id="deviceCard" class="device-card"><span class="device-icon">▦</span><span><strong id="deviceName">Consultando…</strong><small id="deviceDetails">Sin respuesta</small></span><i id="deviceCheck">!</i></div><div class="power-note"><span>ϟ</span><div><strong>Consumo estimado</strong><small id="powerEstimate">Calculando configuración…</small></div></div></aside>
    <aside id="simulatorPanel" class="simulator-panel"><div class="panel-heading"><div><span class="eyebrow">SALIDA REAL</span><h2>Simulador</h2></div><span id="runtimeState" class="chip">OFFLINE</span></div><canvas id="outputCanvas" aria-label="Salida real del dispositivo"></canvas><dl><dt>Dispositivo</dt><dd id="outputDevice">—</dd><dt>Escena</dt><dd id="outputScene">—</dd><dt>Estado</dt><dd id="outputStatus">—</dd><dt>Brillo</dt><dd id="outputBrightness">—</dd><dt>Posición</dt><dd id="outputPosition">—</dd></dl><button class="button" id="stopDeviceButton">Detener dispositivo</button></aside>
  </main><div id="toast" class="toast-message" role="status" aria-live="polite"></div>
</div>
<dialog id="projectsDialog"><form method="dialog" class="dialog-card wide"><header><div><span class="eyebrow">BIBLIOTECA</span><h2>Mis diseños</h2></div><button value="cancel">×</button></header><div class="dialog-actions"><button type="button" class="button primary" id="newProjectButton">Nuevo</button><button type="button" class="button" id="saveAsButton">Guardar como</button><button type="button" class="button" id="duplicateButton">Duplicar</button><button type="button" class="button" id="renameButton">Renombrar</button><button type="button" class="button danger" id="deleteProjectButton">Eliminar</button></div><div id="projectGallery" class="project-gallery"></div></form></dialog>
<dialog id="textDialog"><form method="dialog" class="dialog-card" id="textForm"><header><div><span class="eyebrow">OBJETO EDITABLE</span><h2>Texto LED</h2></div><button value="cancel">×</button></header><label>Texto<textarea id="textValue" rows="3">SE ARREGLAN COMPUTADORAS</textarea></label><div class="form-grid"><label>Fuente<select id="textFont"><option value="3x5">3×5</option><option value="5x7" selected>5×7</option><option value="8x8">8×8</option><option value="10x14">10×14</option></select></label><label>Escala<input id="textScale" type="number" min="1" max="8" value="1" /></label><label>Spacing<input id="textSpacing" type="number" min="0" max="8" value="1" /></label><label>Color<input id="textColor" type="color" value="#ff6b35" /></label><label>Alineación H<select id="textAlignH"><option value="center">Centro</option><option value="left">Izquierda</option><option value="right">Derecha</option></select></label><label>Alineación V<select id="textAlignV"><option value="center">Centro</option><option value="top">Arriba</option><option value="bottom">Abajo</option></select></label><label>X<input id="textX" type="number" value="0" /></label><label>Y<input id="textY" type="number" value="0" /></label></div><label class="check"><input id="textClip" type="checkbox" checked /> Recortar al canvas</label><label class="check"><input id="textScroll" type="checkbox" /> Scroll del texto</label><canvas id="textPreview" width="420" height="90"></canvas><footer><button value="cancel" class="button">Cancelar</button><button value="default" class="button primary" id="textApply">Aplicar</button></footer></form></dialog>
<dialog id="imageDialog"><form method="dialog" class="dialog-card" id="imageForm"><header><div><span class="eyebrow">OBJETO EDITABLE</span><h2>Imagen LED</h2></div><button value="cancel">×</button></header><div class="form-grid"><label>X<input id="imageX" type="number" /></label><label>Y<input id="imageY" type="number" /></label><label>Ancho<input id="imageWidth" type="number" min="1" max="128" /></label><label>Alto<input id="imageHeight" type="number" min="1" max="128" /></label><label>Ajuste<select id="imageFit"><option value="contain">Contain</option><option value="cover">Cover</option><option value="stretch">Stretch</option></select></label><label>Recorte izquierdo<input id="imageCropLeft" type="number" min="0" /></label><label>Recorte superior<input id="imageCropTop" type="number" min="0" /></label><label>Recorte derecho<input id="imageCropRight" type="number" min="0" /></label><label>Recorte inferior<input id="imageCropBottom" type="number" min="0" /></label></div><label class="check"><input id="imageNearest" type="checkbox" checked /> Pixel-art nearest-neighbor</label><label class="check"><input id="imageTransparent" type="checkbox" checked /> Respetar transparencia</label><footer><button value="cancel" class="button">Cancelar</button><button value="default" class="button primary" id="imageApply">Aplicar</button></footer></form></dialog>
<dialog id="confirmDialog"><form method="dialog" class="dialog-card small"><h2 id="confirmTitle">Confirmar</h2><p id="confirmMessage"></p><footer><button value="cancel" class="button">Cancelar</button><button value="confirm" class="button danger">Confirmar</button></footer></form></dialog>
